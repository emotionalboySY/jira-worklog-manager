{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "위젯 창 권한 (본체 + 종료/교체 다이얼로그 + 설정 창). 창 제어는 실제 JS 사용처만 — 스냅/리사이즈가 Rust 후킹으로 이관되며 set-size/position 계열은 제거됨. 클릭 통과·설정 창 생성은 Rust 커맨드 경유라 별도 권한이 필요 없다.",
  "windows": ["main", "finish", "swap", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:app:allow-version",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "opener:allow-open-url",
    "store:default",
    "updater:default",
    "process:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.atlassian.com/*" },
        { "url": "https://auth.atlassian.com/*" },
        { "url": "https://jira-worklog-manager.vercel.app/*" }
      ]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
